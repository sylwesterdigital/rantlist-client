{
  "packageId": "fun.workwork.rantlist",
  "host": "rantlist.me",
  "name": "Rantlist",
  "launcherName": "Rantlist",
  "display": "standalone",
  "displayOverride": [
    "standalone"
  ],
  "themeColor": "#fafafa",
  "themeColorDark": "#111111",
  "navigationColor": "#000000",
  "navigationColorDark": "#000000",
  "navigationDividerColor": "#000000",
  "navigationDividerColorDark": "#000000",
  "backgroundColor": "#fafafa",
  "enableNotifications": false,
  "startUrl": "/?rantlistPwa=1",
  "iconUrl": "https://rantlist.me/assets/pwa/rantlist-512.png",
  "maskableIconUrl": "https://rantlist.me/assets/pwa/rantlist-512.png",
  "splashScreenFadeOutDuration": 300,
  "signingKey": {
    "path": "__SIGNING_KEY_PATH__",
    "alias": "rantlist"
  },
  "appVersion": "__APP_VERSION__",
  "appVersionCode": 1,
  "shortcuts": [],
  "generatorApp": "@meta-quest/bubblewrap-cli",
  "webManifestUrl": "https://rantlist.me/manifest.webmanifest",
  "fallbackType": "customtabs",
  "features": {},
  "alphaDependencies": {
    "enabled": false
  },
  "enableSiteSettingsShortcut": false,
  "isChromeOSOnly": false,
  "isMetaQuest": true,
  "horizonOSAppMode": "2D",
  "fullScopeUrl": "https://rantlist.me/",
  "minSdkVersion": 23,
  "orientation": "landscape",
  "fingerprints": [],
  "additionalTrustedOrigins": [],
  "retainedBundles": [],
  "protocolHandlers": [],
  "fileHandlers": [],
  "launchHandlerClientMode": "navigate-existing",
  "shareTarget": {
    "action": "https://rantlist.me/pwa-share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "video/*",
            "audio/*",
            "application/pdf",
            "text/plain",
            "application/zip",
            "application/octet-stream"
          ]
        }
      ]
    }
  }
}
